inlimbo.brussels, www.inlimbo.brussels {
    @og_bots {
        path_regexp og_slug ^/aanbieding/(.+)$
        header_regexp User-Agent "(?i)(whatsapp|facebookexternalhit|facebot|twitterbot|linkedinbot|telegrambot|slackbot|discordbot|pinterest)"
    }
    handle @og_bots {
        # /aanbieding/{slug}  →  /api/og/aanbieding/{slug}
        # {re.og_slug.1} = de eerste capture-groep uit path_regexp hierboven,
        # dus alles na "/aanbieding/" (bv. "television-1990s-2000s").
        rewrite * /api/og/aanbieding/{re.og_slug.1}
        reverse_proxy backend:8000
    }

    reverse_proxy frontend:80
}
ntfy.inlimbo.brussels {
    reverse_proxy ntfy:80
}
stats.inlimbo.brussels {
    reverse_proxy umami:3000
}
